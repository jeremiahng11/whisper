# Copy to .env for local `docker compose up`. In Coolify, set these under Environment Variables instead.
API_KEY=change-me-to-a-long-random-string      # e.g. openssl rand -hex 32
WHISPER_MODEL=large-v3-turbo                    # tiny | base | small | medium | large-v3 | large-v3-turbo
DEFAULT_LANGUAGE=                               # empty = auto-detect; "en" if all meetings are English
INITIAL_PROMPT=                                 # names / jargon to help spelling, e.g. "Aleta Planet, SkenPay, Coolify"
SUMMARY_BACKEND=ollama                          # ollama | openai | none
OLLAMA_MODEL=qwen2.5:7b-instruct
SUMMARY_LANGUAGE=                               # empty = same as the recording; "English" to always summarise in English
KEEP_AUDIO_DAYS=30                              # delete audio after N days (transcripts are kept); 0 = never
# Speaker labels (build arg + runtime):
INSTALL_DIARIZE=0
DIARIZE=0
HF_TOKEN=
